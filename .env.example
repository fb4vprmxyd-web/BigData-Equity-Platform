# =============================================================================
# Environment variables for CW1 + CW2 pipeline
# Copy this file to .env and fill in your own values:
#   cp .env.example .env
# NEVER commit .env to git — it is in .gitignore.
# =============================================================================

# --- CW1 Infrastructure (Docker services) ---
MINIO_USER=ift_bigdata
MINIO_PASSWORD=minio_password
MINIO_URL=http://localhost:9000
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST_DEV=localhost
POSTGRES_PORT_DEV=5439
POSTGRES_HOST_DOCKER=postgres_db
POSTGRES_PORT_DOCKER=5432
POSTGRES_DATABASE=fift
MONGO_HOST=localhost
MONGO_PORT=27019
MONGO_USERNAME=ift_bigdata
MONGO_PASSWORD=mongo_password
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- CW1 Data Extraction ---
FINNHUB_API_KEY=<your-finnhub-key>

# --- Refinitiv / LSEG Data Platform (ESG scores) ---
REFINITIV_USERNAME=<your-ucl-email>
REFINITIV_PASSWORD=<your-refinitiv-password>
REFINITIV_APP_KEY=<your-refinitiv-app-key>

# --- NewsAPI (secondary news source — gap-fill) ---
NEWSAPI_KEY=<your-newsapi-key>

# --- Alpha Vantage (CW2 historical sentiment — 9 keys for round-robin) ---
# Free tier: 25 calls/day per key. 9 keys = 225 calls/day combined.
# Get free keys at https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_KEY_1=<your-av-key-1>
ALPHA_VANTAGE_KEY_2=<your-av-key-2>
ALPHA_VANTAGE_KEY_3=<your-av-key-3>
ALPHA_VANTAGE_KEY_4=<your-av-key-4>
ALPHA_VANTAGE_KEY_5=<your-av-key-5>
ALPHA_VANTAGE_KEY_6=<your-av-key-6>
ALPHA_VANTAGE_KEY_7=<your-av-key-7>
ALPHA_VANTAGE_KEY_8=<your-av-key-8>
ALPHA_VANTAGE_KEY_9=<your-av-key-9>

# --- Financial Modeling Prep (non-US fundamentals supplement) ---
FMP_API_KEY=<your-fmp-key>

# --- SimFin (bulk financial statement data) ---
SIMFIN_API_KEY=<your-simfin-key>
